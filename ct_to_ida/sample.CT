      <ID>1</ID>
      <Description>"Player Health"</Description>
      <VariableType>4 Bytes</VariableType>
      <Address>ac_client.exe+0x18EC</Address>
    </CheatEntry>

    <!-- module+offset with single dereference -->
    <CheatEntry>
      <ID>2</ID>
      <Description>"Player Base Ptr"</Description>
